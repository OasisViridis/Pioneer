      "variants": [
        {
          "nodeId": "921:619",
          "name": "State=Active",
          "status": "preserved-difference",
          "reason": "Map one session item inside SessionTabStrip; state.activeTabId determines aria-selected. Preserve current responsive width, project subtitle and inactive close button (pointer accessible, tabindex -1), rather than claiming pixel parity with Figma.",
          "exercise": "Create two real sessions, verify selected/unselected colors and close focus policy, activate and close each, reopen retained sessions. Close and reopen a running session without stopping its Run.",
          "evidence": [
            {
              "path": "tests/e2e/design-mappings.e2e.spec.ts",
              "test": "S1 session and dock compositions preserve selection, focus and close semantics"
            },
            {
              "path": "tests/e2e/p2-run.e2e.spec.ts",
              "test": "stops mid-run and shows 已停止 only after background convergence"
            }
          ]
        },
        {
