{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pioneer:m5a/record-schema/1",
  "title": "M5-A experiment dataset row (protocol v1)",
  "description": "One de-identified experiment record per line of dataset.jsonl. Field semantics and cross-field invariants are frozen by docs/experiments/m5a/v1/protocol.json and enforced by tools/experiments/lib/record.mjs plus tests. Prompt text and model answer text are never stored; only SHA-256 digests and byte counts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "datasetVersion",
    "evidenceKind",
    "attemptId",
    "rowId",
    "task",
    "variant",
    "repetition",
    "orderIndex",
    "run",
    "usage",
    "result",
    "environment",
    "capture",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolId": { "const": "m5a-harness-context-comparison" },
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "datasetVersion": { "type": "integer", "minimum": 1 },
    "evidenceKind": {
      "enum": ["controlled", "real-provider"],
      "description": "controlled = pipeline dry run on synthetic captures, never a model result. real-provider = authorized live Provider run."
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Pre-registered attempt id. The denominator counts every one of these, including not_run."
    },
    "rowId": {
      "type": "string",
      "pattern": "^[a-z-]+:v[0-9]+:[a-z0-9-]+$",
      "description": "<evidenceKind>:v<datasetVersion>:<attemptId>, e.g. controlled:v1:a-0001"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "category", "promptSha256", "rubricId"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^t[0-9]{2}$" },
        "category": {
          "enum": [
            "locate-exact-fact",
            "aggregate-count",
            "cross-file-synthesis",
            "negative-scope"
          ]
        },
        "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rubricId": { "type": "string", "pattern": "^r[0-9]{2}$" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "harnessVersion"],
      "properties": {
        "variantId": {
          "enum": ["pioneer-readonly-tools", "fixed-prefix-no-tools"]
        },
        "harnessVersion": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
    "orderIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72,
      "description": "Frozen randomized execution order; identical order is reused across repetitions of the same cell."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "projectId",
        "runId",
        "revision",
        "adapter",
        "status",
        "failureCode",
        "stopReason",
        "startedAt",
        "terminalAt",
        "durationMs",
        "lastSeq",
        "toolCalls"
      ],
      "properties": {
        "sessionId": {
          "type": ["string", "null"],
          "description": "Opaque main-assigned id. null only when status is not_run."
        },
        "projectId": { "type": ["string", "null"] },
        "runId": {
          "type": ["string", "null"],
          "description": "null only when status is not_run."
        },
        "revision": { "type": ["integer", "null"], "minimum": 1 },
        "adapter": { "enum": ["pi", "controlled", null] },
        "status": {
          "enum": ["completed", "failed", "stopped", "unknown", "not_run"],
          "description": "Product statuses come from the run journal; not_run is an experiment-layer status and never a product state."
        },
        "failureCode": {
          "enum": [
            "START_FAILED",
            "MODEL_FAILED",
            "TOOL_FAILED",
            "PROTOCOL_ERROR",
            "OUTPUT_LIMIT",
            "RUN_DEADLINE",
            "AUTHORIZATION_REVOKED",
            "STOP_TIMEOUT",
            "ADAPTER_DISCONNECTED",
            null
          ],
          "description": "Mirrors RunFailureCodeSchema; non-null iff status is failed."
        },
        "stopReason": {
          "enum": [
            "user",
            "window_closed",
            "deadline",
            "authorization_revoked",
            "host_failure",
            null
          ],
          "description": "Mirrors run.stop_requested.reason; non-null iff status is stopped."
        },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "terminalAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Journal terminal timestamp. A tombstoned run (unknown) has no terminal timestamp."
        },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "terminalAt - startedAt in milliseconds; null when either endpoint is missing."
        },
        "lastSeq": { "type": ["integer", "null"], "minimum": 0 },
        "toolCalls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "succeeded",
            "rejected",
            "failed",
            "cancelled"
          ],
          "properties": {
            "requested": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "source", "estimated"],
      "properties": {
        "inputTokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Provider-reported prompt tokens. null means not reported; it is never replaced by 0."
        },
        "outputTokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "source": {
          "enum": ["reported", "missing", "estimated"],
          "description": "missing iff both token values are null. estimated requires usage.estimated."
        },
        "estimated": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputTokens", "outputTokens", "method"],
              "properties": {
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "method": { "enum": ["bytes/4"] }
              }
            }
          ],
          "description": "Estimate kept separate from measured usage and never mixed into measured means."
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoringMode",
        "verdict",
        "rubricId",
        "matchedLiterals",
        "requiredLiterals",
        "answerSha256",
        "answerBytes"
      ],
      "properties": {
        "scoringMode": { "enum": ["deterministic"] },
        "verdict": {
          "enum": ["pass", "fail", "unscorable", "not_run"],
          "description": "not_run iff status is not_run; otherwise scored from the answer text."
        },
        "rubricId": { "type": "string", "pattern": "^r[0-9]{2}$" },
        "matchedLiterals": { "type": "integer", "minimum": 0 },
        "requiredLiterals": { "type": "integer", "minimum": 0 },
        "answerSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the normalized answer text stored in answers.ndjson. The same value appears there, so a third party can verify the row against the stored normalized text. Raw answer text is never retained."
        },
        "answerBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "UTF-8 byte length of the normalized answer text; equals answers.ndjson.answerBytes."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "softwareCommit",
        "dirty",
        "platform",
        "nodeVersion",
        "electronVersion",
        "provider",
        "modelId",
        "endpointOrigin",
        "corpusId",
        "corpusManifestSha256"
      ],
      "properties": {
        "softwareCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "electronVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "endpointOrigin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+$",
          "description": "Scheme and host only; never credentials, paths or query strings."
        },
        "corpusId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "corpusManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureManifestSha256",
        "journalSha256",
        "eventsSha256"
      ],
      "properties": {
        "captureManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "journalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eventsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 512,
      "description": "Required for not_run (reason code plus one line of detail). Must not contain paths, credentials or answer text."
    }
  },
  "$comment": "Cross-field invariants enforced by tools/experiments and tests/experiments: (1) usage.source=missing iff inputTokens=outputTokens=null; (2) status=completed => failureCode=null and stopReason=null; status=failed => failureCode non-null; status=stopped => stopReason non-null; status=unknown => terminalAt=null; status=not_run => run ids null, durationMs null, verdict not_run, notes non-empty; (3) verdict=not_run iff status=not_run; (4) every attempt in capture.json appears exactly once and the dataset row count equals the registered denominator; (5) no row may contain absolute paths, prompt text, answer text or credential-shaped strings."
}
