# ==============================================================================
# Pioneer · 毕业设计工程规范 (.gitignore)
# ==============================================================================

# AI 协同追踪、子代理运行记录与中间日志
.agents/
.workbuddy/
.workbuddy-ai/
.mimosa/
.firecrawl/

# 临时中间产物（非项目交付物，不污染仓库与产线）
tmp/
logs/
.scratch/
screenshots-private/

# 依赖与编译构建产物及本地日志
node_modules/
dist/
build/
coverage/
tests/e2e/test-output/
test-results/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 临时转录、渲染与抓取中间产物
kdocs_*
meeting_*
pioneer-cinematic-*

# 操作系统临时与缩略图缓存
.DS_Store
Thumbs.db
desktop.ini

# IDE 与编辑器临时配置
.vscode/
.idea/
*.suo
*.user

# 环境变量与私有配置
.env
.env.*
*.local
!.env.example
out/
.webpack/
.pnpm-store/

# 凭据与密钥材料（任何情况下不得入库）
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials*.txt
secrets.json
__pycache__
*.pyc

# 本地私有材料（隔离备份 / 未审计二进制 / 个人笔记）
.private/
.quarantine/
local-secrets/
